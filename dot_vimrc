" ~/.vimrc — the single Vim config, sourced by all three: terminal `vim`,
" `gvim`, and MacVim (`mvim`). gvim/MacVim load ~/.vimrc first (then ~/.gvimrc,
" which we deliberately don't keep), so everything below — keybindings included
" — applies everywhere with no duplication. GUI-only settings are applied via a
" GUIEnter autocmd so they take effect once the window exists and never touch a
" terminal. Plugin-free; nvim (~/.config/nvim) is the primary editor.

set nocompatible
syntax enable
filetype plugin indent on

""""""""""""""""""""""""
" colors
""""""""""""""""""""""""
set background=dark
" molokai is vendored in ~/.vim/colors/; silent! so a miss doesn't error
silent! colorscheme molokai

""""""""""""""""""""""""
" GUI (gvim / MacVim only — fired after the window exists so sizing sticks)
""""""""""""""""""""""""
autocmd GUIEnter * set guifont=Monaco:h15 lines=50 columns=90
                 \ guioptions-=T guioptions-=r guioptions-=L

""""""""""""""""""""""""
" general
""""""""""""""""""""""""
set encoding=utf-8
" share the system clipboard
set clipboard=unnamed
set hidden
set autoread
set modelines=0
set backspace=indent,eol,start
set noerrorbells visualbell t_vb=
" no intro screen
set shortmess+=I
set lazyredraw
set history=1000

" appearance
set ruler
set showmode
set cursorline
set laststatus=2
set nonumber
set nowrap
set textwidth=80
set colorcolumn=81
set listchars=tab:▸\ ,trail:▫
set nolist

" indentation
set expandtab
set tabstop=2 shiftwidth=2 softtabstop=2
set autoindent copyindent

" search
set ignorecase smartcase
set gdefault incsearch showmatch hlsearch

" movement
set scrolloff=5
set wildmenu wildmode=list:longest

" no swap/backup clutter; keep persistent undo
set nobackup noswapfile
if !isdirectory($HOME . '/.vim/undo') | call mkdir($HOME . '/.vim/undo', 'p') | endif
set undofile undodir=~/.vim/undo

" spelling — off by default, on per-filetype below; word list shared with nvim
set spelllang=en
set spellfile=~/.vim/spell/en.utf-8.add
set nospell

set pastetoggle=<F2>

" wildignore
set wildignore+=*/tmp/*,*.swp,*.zip,*.out
set wildignore+=*.so,*.dylib,*.a,*.o
set wildignore+=.git,.hg,.svn
set wildignore+=*.class
set wildignore+=node_modules

""""""""""""""""""""""""
" key bindings
""""""""""""""""""""""""
" NOTE: :map / :autocmd don't support trailing " comments — the text would be
" swallowed into the mapping. Keep comments on their own lines.
let mapleader=","

" clear search highlight
nnoremap <leader><space> :noh<cr>
" delete without clobbering the yank register
nnoremap <silent> <leader>d "_d
vnoremap <silent> <leader>d "_d
" toggle invisible chars
nnoremap <leader>i :set list!<cr>
" reload / edit this file
nnoremap <leader>S :source $MYVIMRC<cr>
nnoremap <leader>E :vsplit $MYVIMRC<cr>
" sort selection / paragraph
vnoremap <leader>s !sort -f<cr>gv
nnoremap <leader>s vip!sort -f<cr><Esc>

" very-magic search
nnoremap / /\v
vnoremap / /\v
" jump between matching pairs
nnoremap <tab> %
vnoremap <tab> %
" quick colon
nnoremap ; :
vnoremap ; :
" move by display line when wrapped
nnoremap j gj
nnoremap k gk
" yank to end of line
nnoremap Y y$

" cut / copy to the macOS clipboard
vmap <C-x> :!pbcopy<cr>
vmap <C-c> :w !pbcopy<cr><cr>

" navigate splits with ctrl+hjkl
map <C-h> <C-w>h
map <C-j> <C-w>j
map <C-k> <C-w>k
map <C-l> <C-w>l

" save on lost focus
autocmd FocusLost * silent! wa

" disable arrow keys; use :wq, not ZZ
inoremap <Up> <NOP>
inoremap <Down> <NOP>
inoremap <Left> <NOP>
inoremap <Right> <NOP>
noremap <Up> <NOP>
noremap <Down> <NOP>
noremap <Left> <NOP>
noremap <Right> <NOP>
nnoremap ZZ <NOP>

""""""""""""""""""""""""
" filetypes
""""""""""""""""""""""""
augroup filetypedetect
  autocmd!
  autocmd BufRead,BufNewFile Podfile       setf ruby
  autocmd BufRead,BufNewFile *.json.schema setf javascript
  autocmd BufRead,BufNewFile *.md          setf markdown
  " vim-anywhere popups (temp file under .../vim-anywhere/): edit as prose
  autocmd BufRead,BufNewFile */vim-anywhere/*
        \ setlocal filetype=markdown spell wrap linebreak textwidth=0 colorcolumn=
augroup END

augroup spell_checking
  autocmd!
  autocmd FileType text,markdown,gitcommit setlocal spell
augroup END

augroup invisible_chars
  autocmd!
  autocmd FileType vim,ruby,javascript,css setlocal list
augroup END

augroup alternate_spacing
  autocmd!
  autocmd FileType java,xml,python setlocal tabstop=4 shiftwidth=4 softtabstop=4
augroup END
