" ~/.gvimrc.min — minimal MacVim config for vim-anywhere popups.
"
" Loaded via `mvim -u ~/.gvimrc.min` (see ~/.vim-anywhere/bin/run). Kept
" deliberately small: this is for quick edits of text-field content (comments,
" messages, short prose), not a full IDE. The real editor config lives in
" ~/.config/nvim, which MacVim never reads.

set nocompatible
syntax enable
filetype plugin indent on

" --- GUI window + font (preserved from the previous ~/.gvimrc) ---
set lines=50 columns=90
set guifont=Monaco:h15
set guioptions-=T          " no toolbar
set guioptions-=rL         " no scrollbars

" no error bells
set noerrorbells visualbell t_vb=

" --- editing quality-of-life ---
set encoding=utf-8
set clipboard=unnamed      " share the system clipboard
set backspace=indent,eol,start
set scrolloff=3
set ignorecase smartcase
set incsearch hlsearch

" indentation
set expandtab
set tabstop=2 shiftwidth=2 softtabstop=2
set autoindent

" prose-friendly: soft-wrap long lines at word boundaries
set wrap linebreak

" spell-check on — popups are usually prose. Shares one personal word list with
" Neovim (set in ~/.config/nvim/lua/options.lua), so words added with `zg` in
" either editor show up in both.
set spelllang=en
set spellfile=~/.vim/spell/en.utf-8.add
set spell

" throwaway temp files — no clutter
set nobackup noswapfile noundofile
